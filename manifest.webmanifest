{
  "id": "./",
  "name": "Running Mate",
  "short_name": "Running Mate",
  "description": "GPS run tracker with route maps and timed training sessions",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "categories": ["sports", "health", "fitness"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Training plan", "short_name": "Training", "url": "./#plan", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Run history", "short_name": "History", "url": "./#history", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
